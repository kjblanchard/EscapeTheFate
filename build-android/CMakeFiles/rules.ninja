  command = $PRE_LINK && /Users/kevin/Library/Android/sdk/cmake/3.31.6/bin/cmake -E rm -f $TARGET_FILE && /Users/kevin/Library/Android/sdk/ndk/27.0.12077973/toolchains/llvm/prebuilt/darwin-x86_64/bin/llvm-ar qc $TARGET_FILE $LINK_FLAGS $in && /Users/kevin/Library/Android/sdk/ndk/27.0.12077973/toolchains/llvm/prebuilt/darwin-x86_64/bin/llvm-ranlib $TARGET_FILE && /Users/kevin/Library/Android/sdk/cmake/3.31.6/bin/cmake -E touch $TARGET_FILE && $POST_BUILD
  description = Linking C static library $TARGET_FILE
  restat = $RESTAT


