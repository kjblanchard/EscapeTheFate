rule CXX_DYNDEP__SDL3-static_Debug
  command = /Users/kevin/Library/Android/sdk/cmake/3.31.6/bin/cmake -E cmake_ninja_dyndep --tdi=_deps/sdl3-build/CMakeFiles/SDL3-static.dir/CXXDependInfo.json --lang=CXX --modmapfmt=clang --dd=$out @$out.rsp
